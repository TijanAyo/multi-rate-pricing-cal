{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    // NOT `incremental`. nest-cli.json sets `deleteOutDir: true`, which wipes
    // dist/ on every build — but a .tsbuildinfo file survives that deletion.
    // TypeScript would then trust the stale build info, decide the output was
    // already current, and emit nothing at all, leaving `nest start` to fail
    // with "Cannot find module dist/main" after reporting zero errors.
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
