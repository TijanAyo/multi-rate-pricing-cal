node_modules/
dist/
.next/
coverage/
*.tsbuildinfo

# Ignore every env file by default, then allow the committed template back in.
# The broad pattern matters: a narrow ".env" rule would leave files like
# .env.production — which hold real credentials — committable.
.env
.env.*
!.env.example

.DS_Store
*.log
npm-debug.log*
