# ---- API (apps/api/.env) ----
NODE_ENV=development
PORT=4000

# Local dev points at the docker-compose Postgres (host port 5433).
DATABASE_URL=postgres://pricing:pricing@localhost:5433/pricing

# In production (Neon) use the pooled connection string, e.g.
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/pricing?sslmode=require

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins. Must match the port the web
# app actually runs on (apps/web/package.json -> scripts.dev), or the browser
# will block every API call with a CORS error.
CORS_ORIGIN=http://localhost:3005

# ---- Web (apps/web/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
